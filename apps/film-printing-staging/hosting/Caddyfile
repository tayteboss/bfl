{
	admin off
	# Do not record signed proxy queries, session credentials or private cart IDs.
	log default {
		output discard
	}
}
{$BFL_HOSTNAME} {
	header {
		Cache-Control "no-store"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
	}
	@direct path /session/challenge /session/exchange /session/context /session/revoke
	handle @direct {
		reverse_proxy runtime:6076 {
			# Observed TCP peer only. Never trust a supplied forwarded chain.
			header_up X-BFL-Direct-Peer {remote_host}
			header_up -X-Forwarded-For
			header_up -X-Real-IP
			header_up -Forwarded
			header_up -Shopify-Storefront-Buyer-IP
			header_up -Cookie
		}
	}
	# Resource sessions are cookie-free and carry no buyer-IP authority. Reject
	# cookies before stripping ingress headers; preserve Authorization for direct
	# session endpoints only. No jobs/uploads/quote/authority route is exposed.
	@resource path /resource-proof/challenge /resource-proof/exchange /resource-sessions/issue /resource-sessions/renew /resource-sessions/revoke
	handle @resource {
		@cookie header Cookie *
		respond @cookie 403
		reverse_proxy runtime:6076 {
			header_up -X-Forwarded-For
			header_up -X-Real-IP
			header_up -Forwarded
			header_up -Shopify-Storefront-Buyer-IP
			header_up -X-BFL-Direct-Peer
			header_up -Cookie
		}
	}
	@staging path /healthz /readyz /proxy/bootstrap /proxy/resource-proof
	handle @staging {
		reverse_proxy runtime:6076 {
			header_up -X-Forwarded-For
			header_up -X-Real-IP
			header_up -Forwarded
			header_up -Shopify-Storefront-Buyer-IP
			header_up -X-BFL-Direct-Peer
			header_up -Cookie
		}
	}
	handle {
		respond 404
	}
}
